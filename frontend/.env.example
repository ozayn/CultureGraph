# CultureGraph Web — copy to frontend/.env.local for local development.
# On Railway, set these in the Web service variables panel (not the repo root).

# Browser-facing API URL (required at build time on Railway)
# Must point to the CultureGraph API service, NOT the frontend URL.
# Local:
NEXT_PUBLIC_API_URL=http://localhost:8000
# Railway example:
# NEXT_PUBLIC_API_URL=https://your-api-service.up.railway.app

# Optional canonical site URL for OpenGraph / metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Sign-In client ID (public; must match backend GOOGLE_CLIENT_ID exactly)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Local dev port (used by scripts/start.sh and scripts/dev.sh)
WEB_PORT=3000
