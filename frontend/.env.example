# CultureGraph Web — copy to apps/web/.env.local (or frontend/.env.local) for local development.
# On Railway, set these in the Web service variables panel (not the repo root).

# Browser-facing API URL (required at build time on Railway)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional canonical site URL for OpenGraph / metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local dev port (used by scripts/start.sh only)
WEB_PORT=3000
