# =============================================================================
# CultureGraph — environment variables
# Copy to .env at the repo root for local development.
# =============================================================================

# --- Database (API) ---
# Local Docker Compose default:
DATABASE_URL=postgresql://culturegraph:culturegraph@localhost:5432/culturegraph
# Railway: attach a Postgres plugin; DATABASE_URL is injected automatically.

# --- API (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000
UPLOAD_DIR=uploads
# Comma-separated origins. Include your Railway web URL in production.
CORS_ORIGINS=http://localhost:3000

# --- Web (Next.js) ---
# Browser-facing API URL. Must be set at build time on Railway.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: canonical site URL for OpenGraph metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Local web port (scripts/start.sh only) ---
WEB_PORT=3000

# =============================================================================
# Railway notes
# - API service root directory: backend/  (or apps/api/)
# - Web service root directory: frontend/ (or apps/web/)
# - API: PORT is set by Railway; do not hardcode.
# - Web: set NEXT_PUBLIC_API_URL to the public API URL before deploy/build.
# =============================================================================
