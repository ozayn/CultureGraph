# CultureGraph API — copy to backend/.env for local development.
# On Railway, set these in the API service variables panel (not the repo root).

# Database (Railway Postgres plugin injects DATABASE_URL automatically)
DATABASE_URL=postgresql://culturegraph:culturegraph@localhost:5432/culturegraph

# Server
API_HOST=0.0.0.0
API_PORT=8000
UPLOAD_DIR=uploads

# Comma-separated browser origins allowed to call the API (include https:// on Railway)
CORS_ORIGINS=http://localhost:3000
# Railway example:
# CORS_ORIGINS=https://your-web-service.up.railway.app

# AI research (API only — never set on the Web service)
ANTHROPIC_API_KEY=

# Optional Claude overrides
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_TIMEOUT_SECONDS=60
# ANTHROPIC_MAX_TOKENS=2048
