# CultureGraph API — copy to backend/.env for local development.
# On Railway, set these in the API service variables panel (not the repo root).

# Database (Railway Postgres plugin injects DATABASE_URL automatically)
DATABASE_URL=postgresql://culturegraph:culturegraph@localhost:5432/culturegraph

# Pytest uses a separate database — never the dev DB above.
TEST_DATABASE_URL=postgresql://culturegraph:culturegraph@localhost:5432/culturegraph_test

# Server
API_HOST=0.0.0.0
API_PORT=8000
UPLOAD_DIR=uploads
# Railway production: mount a volume at /app/uploads and set UPLOAD_DIR=/app/uploads
# UPLOAD_STORAGE_BACKEND=filesystem
# Maximum artwork upload size in bytes (default 10 MB)
# UPLOAD_MAX_BYTES=10485760
APP_ENV=development

# Comma-separated browser origins allowed to call the API (include https:// on Railway)
# Must include the exact deployed frontend origin, e.g. https://your-web-service.up.railway.app
CORS_ORIGINS=http://localhost:3000
# Railway example:
# CORS_ORIGINS=https://your-web-service.up.railway.app

# AI research (API only — never set on the Web service)
ANTHROPIC_API_KEY=

# Google login + private editing (API only)
# GOOGLE_CLIENT_ID must match frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID exactly.
GOOGLE_CLIENT_ID=
# Use your exact Google account email(s), lowercase is fine.
ADMIN_EMAILS=your-email@gmail.com
# Long random secret for app JWTs (required in production).
JWT_SECRET=

# Optional Claude overrides
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_TIMEOUT_SECONDS=90
# ANTHROPIC_MAX_TOKENS=2048

# Visual artwork matching (optional — install requirements-visual.txt for OpenCLIP)
# VISUAL_EMBEDDING_BACKEND=openclip
# VISUAL_EMBEDDING_MODEL=ViT-B-32
# VISUAL_EMBEDDING_PRETRAINED=openai
# NGA_INDEX_LIMIT=2000
# VISUAL_MATCH_TOP_K=12

# Audio note transcription (OpenAI Whisper)
# OPENAI_API_KEY=
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# AUDIO_NOTE_MAX_BYTES=26214400

# Optional web visual search fallback (SerpApi Google Lens — API only, never frontend)
# SERPAPI_API_KEY=
# PUBLIC_API_BASE_URL=https://your-api.up.railway.app
# SERPAPI_TIMEOUT_SECONDS=45
# LENS_SEARCH_MAX_RESULTS=12
